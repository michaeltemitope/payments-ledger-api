# Disposable local configuration only. Copy to .env; never use production secrets.
# Keep credentials consistent in the URLs below; URL-encode special characters.
POSTGRES_USER=payments
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=payments
# Must differ from POSTGRES_DB and end in _test. Tests delete data and reverse migrations.
POSTGRES_TEST_DB=payments_test

# Published host ports. If PostgreSQL or Redis ports change, update the test URLs.
# Container URLs continue to use the internal ports 5432 and 6379.
POSTGRES_PORT=5432
REDIS_PORT=6379
PAYMENTS_PORT=8000

# Application settings. Compose explicitly sets development and 0.0.0.0 inside
# the container; other optional settings below are defaults, not Compose overrides.
PAYMENTS_ENVIRONMENT=development
PAYMENTS_LOG_LEVEL=INFO
PAYMENTS_LISTEN_HOST=127.0.0.1
PAYMENTS_DATABASE_TIMEOUT_SECONDS=3
PAYMENTS_REDIS_TIMEOUT_SECONDS=1
PAYMENTS_DATABASE_POOL_SIZE=5

# Compose service names resolve inside containers. For a host-run app, replace
# postgres and redis with 127.0.0.1 and use the published host ports above.
PAYMENTS_DATABASE_URL=postgresql+psycopg://payments:change_me_local_only@postgres:5432/payments
PAYMENTS_REDIS_URL=redis://redis:6379/0

# Host-run integration tests use a separate, disposable database.
# make test-integration loads .env itself; shell export is unnecessary.
# Already-exported environment variables take precedence over .env values.
PAYMENTS_TEST_DATABASE_URL=postgresql+psycopg://payments:change_me_local_only@127.0.0.1:5432/payments_test
PAYMENTS_TEST_REDIS_URL=redis://127.0.0.1:6379/0
# PostgreSQL creates the test database only when its volume is first initialized.
# Existing volumes must already contain the configured test database.
